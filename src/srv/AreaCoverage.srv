string area_id # id of the area to be covered
bool with_exclusions true # whether to include exlusions in the coverage. Exclusions are fetched from a map
uint16 headland_loops 3 # number of perimeter loops (used unless the coverage_server param outline_count >= 0)
uint16 swath_angle 0 # fill angle in degrees in the map frame; ignored while the coverage_server param optimize_sweep_angle is true (then the area's principal axis is used)

---
# Result
uint16 CODE_SUCCESS = 0
uint16 CODE_INVALID_AREA = 1
uint16 CODE_INVALID_EXCLUSION = 2
uint16 CODE_UNKNOWN_ERROR = 99

uint16 code                # 0 is success, otherwise is error code
string message             # Information message

nav_msgs/Path path         # all passes concatenated, in driving order (gaps between passes are not filled in)
CoveragePath[] paths       # the same passes separately; drive from one to the next with the navigator

CoverageGeometry coverage_geometry # geometry used for the coverage after exclusions
string area_id # area id that defined the polygon
