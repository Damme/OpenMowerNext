<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="openmower">
    <xacro:arg name="use_ros2_control" default="true"/>
    <xacro:arg name="sim_mode" default="false"/>
    <!-- config/hardware/<hardware>.yaml; "worx" selects the Worx mainboard plugin -->
    <xacro:arg name="hardware" default="yardforce500"/>
    <xacro:arg name="worx_transport" default="spidev"/>


    <xacro:property name="hardware" value="$(arg hardware)"/>
    <xacro:property name="robot_yaml" value="$(find open_mower_next)/config/hardware/${hardware}.yaml" />
    <xacro:property name="robot" value="${xacro.load_yaml(robot_yaml)}"/>

    <xacro:include filename="robot_core.xacro" />
    <xacro:include filename="gps.xacro" />
    <xacro:include filename="imu.xacro" />
<!--    <xacro:include filename="camera.xacro" />-->

    <xacro:if value="$(arg use_ros2_control)">
        <xacro:include filename="ros2_control.xacro" />
    </xacro:if>
    <xacro:if value="$(arg sim_mode)">
        <xacro:include filename="webots_control.xacro" />
    </xacro:if>
</robot>
