Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map grid
      Enabled: true
      Alpha: 0.6
      Color Scheme: map
      Topic:
        Value: /map_grid
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Map areas
      Enabled: true
      Topic:
        Value: /map_visualization
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 5
    - Class: rviz_default_plugins/MarkerArray
      Name: Coverage
      Enabled: true
      Topic:
        Value: /coverage/visualization
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 5
    - Class: rviz_default_plugins/MarkerArray
      Name: Virtual obstacles (sim)
      Enabled: true
      Topic:
        Value: /worx_sim/obstacles
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
    - Class: rviz_default_plugins/PointCloud2
      Name: Bump marks
      Enabled: true
      Style: Squares
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 120; 0
      Alpha: 0.5
      Topic:
        Value: /mower_logic/bump_obstacles
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Depth: 5
    - Class: rviz_default_plugins/Path
      Name: Transit plan
      Enabled: true
      Color: 52; 101; 164
      Line Style: Lines
      Topic:
        Value: /plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
    - Class: rviz_default_plugins/Path
      Name: FTC pass
      Enabled: true
      Color: 25; 255; 0
      Line Style: Lines
      Topic:
        Value: /FTC/global_plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
    - Class: rviz_default_plugins/Pose
      Name: FTC carrot
      Enabled: true
      Color: 255; 25; 0
      Shape: Axes
      Axes Length: 0.3
      Axes Radius: 0.03
      Topic:
        Value: /FTC/global_point
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
    - Class: rviz_default_plugins/Odometry
      Name: Robot trail
      Enabled: true
      Keep: 3000
      Position Tolerance: 0.05
      Angle Tolerance: 0.3
      Shape:
        Value: Arrow
        Color: 255; 170; 0
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.03
      Covariance:
        Value: false
      Topic:
        Value: /odometry/filtered/map
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Depth: 5
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 5
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Color: 255; 255; 255
      Topic:
        Value: /local_costmap/published_footprint
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 10
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 40
      X: 2.2
      Y: 7.5
      Angle: 0
Window Geometry:
  Width: 1400
  Height: 900
