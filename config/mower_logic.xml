<?xml version="1.0"?>
<!--
  Mowing mission. Priorities top to bottom (ReactiveFallback re-checks them
  every tick, a higher branch halts a lower one):
    emergency > charging > rain > mowing (paused while GPS is bad) > go home > idle.
  After a charging / rain return the mower stays docked (auto_resume false,
  Daniel): start_mowing continues the kept mission.
  The blade is only ever on inside FollowPass.
  A bump (worx_hardware: firmware BlockForward / Collision) stops the transit or
  pass; MowPass then backs up and continues the pass beyond the obstacle, which
  is marked in the costmaps (~/bump_obstacles).
-->
<root BTCPP_format="4" main_tree_to_execute="Main">

  <BehaviorTree ID="Main">
    <ReactiveFallback name="priorities">
      <ReactiveSequence name="emergency">
        <IsEmergency/>
        <Hold state="EMERGENCY"/>
      </ReactiveSequence>

      <ReactiveSequence name="charge">
        <NeedsCharging/>
        <Sequence>
          <SubTree ID="DockIfNeeded" _autoremap="true"/>
          <EndMowingUnlessAutoResume/>
          <Hold state="CHARGING"/>
        </Sequence>
      </ReactiveSequence>

      <ReactiveSequence name="rain">
        <IsRaining/>
        <Sequence>
          <SubTree ID="DockIfNeeded" _autoremap="true"/>
          <EndMowingUnlessAutoResume/>
          <Hold state="WAITING_FOR_RAIN"/>
        </Sequence>
      </ReactiveSequence>

      <ReactiveSequence name="mow">
        <CommandIs value="MOW"/>
        <Sequence>
          <!-- Undock before any GPS check: on the dock the pose comes from the dock and the
               undock is a straight reverse; RTK is weakest under the dock roof (real robot
               2026-09-28: float at the dock cancelled the undock halfway). -->
          <Fallback>
            <Inverter><IsAtDock/></Inverter>
            <Undock/>
            <Sequence>
              <Inverter><IsDocked/></Inverter>
              <ReverseAlongTrack distance="1.5"/>
            </Sequence>
          </Fallback>
        <ReactiveFallback>
          <ReactiveSequence>
            <GpsOK/>
            <SubTree ID="Mow" _autoremap="true"/>
          </ReactiveSequence>
          <ReactiveSequence>
            <Inverter><GpsOK/></Inverter>
            <Hold state="WAITING_FOR_GPS"/>
          </ReactiveSequence>
          <!-- Mow failed with good GPS (e.g. undocking): retried next tick, Undock gives up after max_dock_attempts. -->
          <Hold state="RETRYING"/>
        </ReactiveFallback>
        </Sequence>
      </ReactiveSequence>

      <ReactiveSequence name="home">
        <CommandIs value="HOME"/>
        <Sequence>
          <SubTree ID="DockIfNeeded" _autoremap="true"/>
          <SetCommand value="IDLE"/>
        </Sequence>
      </ReactiveSequence>

      <Hold state="IDLE"/>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="DockIfNeeded">
    <Fallback>
      <IsDocked/>
      <Sequence>
        <!-- Daniel: no docking without knowing where we are, and that needs RTK fixed.
             Waits (as long as it takes) before the approach starts; not re-checked
             during it - float under the dock roof must not abort the final metres. -->
        <ReactiveFallback>
          <GpsOK/>
          <Hold state="WAITING_FOR_GPS"/>
        </ReactiveFallback>
        <FreeFootprint/>
        <Dock/>
      </Sequence>
      <!-- Dock gives up after max_dock_attempts; wait between attempts. -->
      <Sequence>
        <Sleep msec="5000"/>
        <AlwaysFailure/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="Mow">
    <Sequence>
      <BeginMission/>
      <!-- IsAtDock, not IsDocked: an aborted undock leaves the robot off the charger in the dock
           entrance, and Nav2 then refuses to undock ("not in the dock"): reverse straight out. -->
      <Fallback>
        <Inverter><IsAtDock/></Inverter>
        <Undock/>
        <Sequence>
          <Inverter><IsDocked/></Inverter>
          <ReverseAlongTrack distance="1.5"/>
        </Sequence>
      </Fallback>
      <Fallback>
        <KeepRunningUntilFailure>
          <SubTree ID="MowPass" _autoremap="true"/>
        </KeepRunningUntilFailure>
        <MissionFinished/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- One pass: FAILURE only when the mission has no passes left. -->
  <BehaviorTree ID="MowPass">
    <Sequence>
      <GetPass path="{pass_path}" start="{pass_start}" start_index="{pass_start_index}" direct="{pass_direct}"/>
      <Fallback>
        <Sequence>
          <Fallback>
            <IsTrue value="{pass_direct}"/>
            <Sequence>
              <FreeFootprint/>
              <Transit goal="{pass_start}"/>
            </Sequence>
          </Fallback>
          <CornerTurn path="{pass_path}"/>
          <FollowPass path="{pass_path}" start_index="{pass_start_index}"/>
          <CornerTurn/>
        </Sequence>
        <Sequence name="avoid_known_obstacle">
          <AvoidingKnownObstacle/>
          <SkipPastBump/>
        </Sequence>
        <Sequence name="bump_recovery">
          <TakeBump/>
          <ForceSuccess>
            <Fallback>
              <BackUp/>
              <ReverseAlongTrack/>
            </Fallback>
          </ForceSuccess>
          <SkipPastBump/>
        </Sequence>
        <Sequence>
          <PassFailed/>
          <Sleep msec="2000"/>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

</root>
